# ── Database ──────────────────────────────────────────────────────────────────
# Leave blank to run in local-only mode: the game still works, just without
# server-side result capture (no leaderboard is implemented either way).
DATABASE_URL=postgresql://app_user:app_password@localhost:5432/app_db
DB_SSL=false
DB_POOL_MAX=10

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# ── Coin claim (shared with eaze-checkin) ─────────────────────────────────────
# Leave unset locally -> claims run in mock mode (no real transfer call).
EAZE_COINS_AUTH_KEY=
EAZE_COINS_API_URL=https://api.eazeapp.com/payments/free-coins/upload/
